{
  "name": "ai-writer",
  "version": "1.3.1",
  "description": "AI写作助手 - 一键生成公众号文章，支持多平台发布，新增Web界面和微信公众号支持",
  "main": "ai-writer.js",
  "bin": {
    "ai-writer": "./ai-writer.js"
  },
  "scripts": {
    "start": "node ai-writer.js",
    "web": "node web/server.js",
    "dev:web": "nodemon web/server.js",
    "check": "node --check ai-writer.js && node --check web/server.js"
  },
  "keywords": [
    "ai",
    "writer",
    "公众号",
    "article",
    "wechat",
    "automation"
  ],
  "author": "wuleiyuan",
  "license": "MIT",
  "dependencies": {
    "axios": "^1.6.0",
    "chalk": "^4.1.2",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "express": "^4.18.2",
    "form-data": "^4.0.5",
    "xml2js": "^0.6.2"
  },
  "devDependencies": {
    "nodemon": "^3.0.2"
  }
}
